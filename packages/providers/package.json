  },
  "dependencies": {
    "@fleetos/domain": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.0",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "9.39.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.2"
  }
}
