{
  "name": "fleetos",
  "version": "0.0.0",
  "private": true,
  "description": "FleetOS: operations control tower for autonomous fleet owners.",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "prototype:dev": "pnpm --filter @fleetos/prototype dev",
    "prototype:build": "pnpm --filter @fleetos/prototype build"
  },
  "devDependencies": {
    "turbo": "2.11.4"
  }
}
