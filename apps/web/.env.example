# Copy to .env.local, or run `pnpm db:env` with the local Supabase stack running.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only; never expose to the browser.
SUPABASE_SECRET_KEY=
MAILPIT_URL=http://127.0.0.1:54324
# Bearer secret for /api/internal/tick (pg_cron). Local: local-dev-tick-secret (see supabase/seed.sql).
TICK_SECRET=
# Sentry DSN (public). Blank locally so nothing reports to the real project; production value is in .env.production.
NEXT_PUBLIC_SENTRY_DSN=
